# ============================================================
# Nuvora — Variables de entorno
# ============================================================
# Copia este archivo a .env y rellena los valores reales.
# .env NO se commitea (está en .gitignore).

# ============================================================
# APP
# ============================================================
APP_NAME=Nuvora API
APP_VERSION=0.1.0
FRONTEND_URL=https://nuvora-chi.vercel.app

# ============================================================
# DATABASE
# ============================================================
# SQLite local (default): sqlite:///./nuvora.db
# Postgres producción (Aiven): postgresql://user:pass@host:5432/db
# Arquitectura: Vercel (frontend) → Render (backend) → Aiven (PostgreSQL)
DATABASE_URL=sqlite:///./nuvora.db

# ============================================================
# JWT / AUTH
# ============================================================
# SECRET_KEY por defecto en código; sobreescribir en producción.

# ============================================================
# STRIPE (pagos)
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================
# AI — Fase 14.7 (AI Workflow Designer)
# ============================================================
# Feature flag global (si false, /ai/* devuelven 503)
AI_ENABLED=true

# Provider activo:
#   gemini    (Google, API propia, free tier disponible)
#   groq      (OpenAI-compatible, ultrarrápido, free tier)
#   deepseek  (OpenAI-compatible, barato)
#   openai    (OpenAI-compatible, estándar de facto)
#   mistral   (OpenAI-compatible, europeo)
#   anthropic (Claude, API propia)
#   ollama    (local, sin key, solo self-hosted)
# (No implica decisión comercial: solo cuál se usa en runtime)
AI_PROVIDER=gemini

# API keys (solo la del provider activo es necesaria en runtime)
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
# Ollama no requiere key (es local); solo base_url
OLLAMA_BASE_URL=http://localhost:11434/v1

# Modelos por defecto (se pueden sobreescribir)
AI_GEMINI_MODEL=gemini-3.5-flash-lite
AI_GROQ_MODEL=llama-3.3-70b-versatile
AI_DEEPSEEK_MODEL=deepseek-chat
AI_OPENAI_MODEL=gpt-4o-mini
AI_MISTRAL_MODEL=mistral-small-latest
AI_ANTHROPIC_MODEL=claude-3-5-haiku-latest
AI_OLLAMA_MODEL=llama3.2

# Límites y timeouts
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_MAX_PROMPT_LENGTH=2000
AI_MAX_BOT_CONTEXT_KEYS=10
AI_MAX_BOT_CONTEXT_VALUE_LENGTH=500
AI_MAX_TOKENS_OUTPUT=4000

# Clave de cifrado para BYOK (API keys de usuarios)
# Generar con: python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# NO cambiar tras generar (invalidaría las keys ya cifradas)
AI_ENCRYPTION_KEY=
